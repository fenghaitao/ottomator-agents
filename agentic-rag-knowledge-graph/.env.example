# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/agentic_rag
# Example: postgresql://raguser:ragpass123@localhost:5432/agentic_rag_db

# Neo4j Configuration for Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# LLM Provider Configuration
# Set this to github_copilot (using LiteLLM)
LLM_PROVIDER=github_copilot

# GitHub Copilot Authentication
# GitHub Copilot uses OAuth2 authentication - no API key needed
# Just ensure you're authenticated with GitHub CLI: gh auth login
LLM_API_KEY=oauth2

# The LLM you want to use for the agents. Make sure this LLM supports tools!
# GitHub Copilot example: github_copilot/gpt-4.1
LLM_CHOICE=github_copilot/gpt-4.1

# Embedding Provider Configuration
# Set this to github_copilot (using LiteLLM)
EMBEDDING_PROVIDER=github_copilot

# API Key for embedding provider (OAuth2 for GitHub Copilot)
EMBEDDING_API_KEY=oauth2

# The embedding model you want to use for RAG
# GitHub Copilot example: github_copilot/text-embedding-3-small
EMBEDDING_MODEL=github_copilot/text-embedding-3-small

# Ingestion-specific LLM (can be different/faster model for processing)
# Leave empty to use the same as LLM_CHOICE
INGESTION_LLM_CHOICE=github_copilot/gpt-4.1

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8058

# Chunking Configuration (optimized for Graphiti token limits)
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_CHUNK_SIZE=1500

# Vector Search Configuration
VECTOR_DIMENSION=1536  # For OpenAI text-embedding-3-small
MAX_SEARCH_RESULTS=10

# Session Configuration
SESSION_TIMEOUT_MINUTES=60
MAX_MESSAGES_PER_SESSION=100

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# File Processing
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_EXTENSIONS=.md,.txt

# Debug Configuration
DEBUG_MODE=false
ENABLE_PROFILING=false