# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:npg_6OvSkyL9GBsn@ep-solitary-block-adr6sh4l-pooler.c-2.us-east-1.aws.neon.tech/neondb
# ☝️ REPLACE THIS LINE WITH YOUR ACTUAL NEON CONNECTION STRING
# Replace with your actual Neon connection string

# Neo4j Configuration for Knowledge Graph
# Neo4j connection URI - use bolt://localhost:7687 for local, neo4j:// for cloud instances
# IMPORTANT: If running the MCP server through Docker, change localhost to host.docker.internal
NEO4J_URI=neo4j+s://6a9bc9cc.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=WfxFyhS0pGx-NYxa6Iroziy_7GrtHvH0cEGa8yL7pbI

# LLM Provider Configuration
# Set this to github_copilot (using LiteLLM)
LLM_PROVIDER=github_copilot

# API Key Configuration
# For pydantic-ai agent: Use OpenAI API key (GitHub Copilot models will map to OpenAI equivalents)
# For direct LiteLLM usage: GitHub Copilot uses OAuth2 (embeddings work directly)
LLM_API_KEY=sk-your-openai-api-key-here

# The LLM you want to use for the agents. Make sure this LLM supports tools!
# GitHub Copilot example: github_copilot/gpt-4.1
LLM_CHOICE=github_copilot/gpt-4.1

# Embedding Provider Configuration
# Set this to github_copilot (using LiteLLM)
EMBEDDING_PROVIDER=github_copilot

# API Key for embedding provider (OAuth2 for GitHub Copilot)
EMBEDDING_API_KEY=sk-placeholder-key

# The embedding model you want to use for RAG
# GitHub Copilot example: github_copilot/text-embedding-3-small
EMBEDDING_MODEL=github_copilot/text-embedding-3-small

# Ingestion-specific LLM (can be different/faster model for processing)
# Leave empty to use the same as LLM_CHOICE
INGESTION_LLM_CHOICE=github_copilot/gpt-4.1

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8058

# Chunking Configuration (optimized for Graphiti token limits)
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_CHUNK_SIZE=1500

# Vector Search Configuration
VECTOR_DIMENSION=1536  # For OpenAI text-embedding-3-small
MAX_SEARCH_RESULTS=10

# Session Configuration
SESSION_TIMEOUT_MINUTES=60
MAX_MESSAGES_PER_SESSION=100

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# File Processing
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_EXTENSIONS=.md,.txt

# Debug Configuration
DEBUG_MODE=false
ENABLE_PROFILING=false
